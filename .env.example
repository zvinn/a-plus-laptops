# Firebase Configuration
# Get these values from: https://console.firebase.google.com/
# Project Settings > General > Your apps > Firebase SDK snippet
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# EmailJS Configuration
# Get these values from: https://www.emailjs.com/
# Dashboard > Email Services > Add New Service
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key

# reCAPTCHA Configuration
# Get this from: https://www.google.com/recaptcha/admin
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key

# Google Analytics Configuration
# Get this from: https://analytics.google.com/
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Business Configuration
VITE_OWNER_PHONE_NUMBER=20xxxxxxxxxx

# Instructions:
# 1. Copy this file to .env (DO NOT commit .env to Git!)
# 2. Replace all placeholder values with your actual credentials
# 3. Never share your .env file or commit it to version control
